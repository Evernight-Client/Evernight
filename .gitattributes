# Uniform line endings: every text file uses LF on commit and on checkout.
# This does not rely on each machine's core.autocrlf, so Windows / Linux / macOS check out identical bytes.
* text=auto eol=lf

# Windows batch exception: checked out as CRLF by convention (the repository still stores LF).
*.bat text eol=crlf

# Binary assets: no line-ending conversion and no text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.class binary
*.nbt binary
